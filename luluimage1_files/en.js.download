!function(){"use strict";var e,t;e="en",t={banner:{title:"We value your privacy",body:"We use cookies and similar technologies to run this site, remember your preferences, and understand how the site is used. You can accept all, or reject everything that isn't required to make the site work.",acceptAll:"Accept all",rejectAll:"Reject non-essential",customize:"Customize"},modal:{title:"Your Privacy Choices",intro:"Choose which categories of cookies and tracking you allow on this site. Strictly necessary items are always on.",save:"Save My Preferences",cancel:"Cancel",close:"Close",alwaysActive:"Always Active"},categories:{necessary:{title:"Strictly necessary",description:"Required for the site to work (login, security, your consent choice itself). Always on."},functional:{title:"Functional",description:"Remember preferences such as language or settings to improve your experience."},analytics:{title:"Analytics",description:"Helps us understand how visitors use the site. If you reject this, we stop storing or reading any information on your device for analytics. Some measurement continues in an aggregate, anonymous form that does not identify you or your device."},advertising:{title:"Advertising",description:"Personalized advertising and measurement by third-party ad partners."}},footer:{default:"Your Privacy Choices",ccpa:"Do Not Sell or Share My Personal Information"}},(window.__lpConsentI18n||(window.__lpConsentI18n={}))[e]=t}();
